// Cloudflare Workers config for audiovisualnepal.com (Next.js via OpenNext).
// Build: npx opennextjs-cloudflare build   Deploy: npx opennextjs-cloudflare deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "audiovisualnepal",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "audiovisualnepal" }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://www.audiovisualnepal.com",
    "CONTACT_TO": "sales@audiovisualnepal.com"
  },
  "observability": { "enabled": true }
}
